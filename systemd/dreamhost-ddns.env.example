# Copy to /etc/dreamhost-ddns.env and lock it down:
#   sudo install -m 0600 -o root -g root dreamhost-ddns.env.example /etc/dreamhost-ddns.env
# It holds your API key, so it must not be readable by other users.

# DreamHost API key, limited to the functions dns-list_records,
# dns-add_record and dns-remove_record.
DREAMHOST_API_KEY=

# Fully-qualified names to keep pointed at this host, space or comma separated.
DREAMHOST_DDNS_RECORDS=home.example.com

# Dry run: log what would change and change nothing. Read the plan with
#   journalctl -u dreamhost-ddns
# then set this to 0 (or delete the line) to go live.
DREAMHOST_DDNS_DRY_RUN=1

# After a change, ask these authoritative nameservers directly and log how long
# the record took to appear ("VERIFIED ... after Ns (record TTL Ts)").
DREAMHOST_DDNS_VERIFY_NS="ns1.dreamhost.com ns2.dreamhost.com ns3.dreamhost.com"

# Optional:
# Allow removing an existing CNAME at a listed name so an A record can take its
# place (it is put back if adding the A record fails). Off by default.
#DREAMHOST_DDNS_REPLACE_CNAME=0
# Re-list the records at least this often to repair a record edited by hand.
#DREAMHOST_DDNS_RECONCILE_HOURS=6
# Override the IP-lookup services (two must agree). Default: ipify, AWS, icanhazip.
#DREAMHOST_DDNS_IP_SERVICES="https://api.ipify.org https://checkip.amazonaws.com https://icanhazip.com"
